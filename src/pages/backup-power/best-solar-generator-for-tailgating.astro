---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import type { Product } from '../../data/products';

const slugOrder = [
  'ecoflow-river-2-pro',
  'jackery-explorer-500',
  'anker-solix-c800',
  'jackery-explorer-1000-pro',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!).filter(Boolean) as Product[];
const topPick = picks[0];

const panelPairing: Record<string, string> = {
  'ecoflow-river-2-pro':     'EcoFlow 220W Bifacial Panel — full recharge in ~2 hrs',
  'jackery-explorer-500':    'Jackery SolarSaga 100W × 1 — full recharge in ~5–7 hrs',
  'anker-solix-c800':        '200W foldable panel — full recharge in ~2.5 hrs',
  'jackery-explorer-1000-pro':'Jackery SolarSaga 100W × 2 — full recharge in ~5 hrs',
};

const bestFor: Record<string, string> = {
  'ecoflow-river-2-pro':     'Best Overall — Fastest Solar Recharge, Lightest LFP',
  'jackery-explorer-500':    'Best Budget — Proven and Portable',
  'anker-solix-c800':        'Best Value — More Power at a Great Price',
  'jackery-explorer-1000-pro':'Best for All-Day Events — Run Everything Indefinitely',
};
---

<Layout
  title="Best Solar Generator for Tailgating (2025) — Charge From the Sun, Run All Day"
  description="The best solar generators for tailgating in 2025 — power stations with high solar input that recharge from the sun while you use them. Run a TV, fridge, and speakers all day without fuel."
>
  <div class="bg-amber-50 border-b border-amber-100">
    <div class="max-w-4xl mx-auto px-4 py-2 text-xs text-amber-800 text-center">
      This site earns commissions from purchases made through our links at no extra cost to you.
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 py-12">

    <nav class="text-xs text-gray-400 mb-6">
      <a href="/" class="hover:text-green-700">Home</a>
      <span class="mx-2">›</span>
      <a href="/backup-power/" class="hover:text-green-700">Backup Power</a>
      <span class="mx-2">›</span>
      Best Solar Generator for Tailgating
    </nav>

    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3 leading-tight">
      Best Solar Generator for Tailgating (2025)
    </h1>
    <p class="text-sm text-gray-400 mb-6">Last updated: June 2025</p>

    <p class="text-lg text-gray-700 mb-4 leading-relaxed">
      A solar generator for tailgating is different from a regular battery power station: you're not just running on battery — you're recharging from the sun while you use it. Point a solar panel at the sky and your power station keeps refilling all day, letting you run a TV, mini-fridge, speaker, and phone charger for an entire game without worrying about running out.
    </p>
    <p class="text-lg text-gray-700 mb-8 leading-relaxed">
      The key spec to look for is <strong>solar input</strong>, not just battery capacity. A 1000Wh unit with a 200W solar input cap can accept enough sun power to stay net-positive through a 5-hour tailgate if your load is below 200W. A 500W solar input unit recharges even faster than you use it.
    </p>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-8 text-sm text-amber-900">
      <strong>Solar vs. regular battery for tailgating:</strong> A standard battery power station runs until empty, then you're done. A solar generator setup keeps going as long as the sun is out. On a clear game day, a good solar panel paired with any of these units will produce 150–400Wh per hour — enough to offset most typical tailgate loads. In overcast conditions, solar production drops 50–70% but still extends runtime meaningfully.
    </div>

    <!-- Top Pick -->
    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-10">
      <p class="text-xs font-semibold text-green-700 uppercase tracking-widest mb-2">Top Pick — Best Solar Tailgate Generator</p>
      <p class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</p>
      <p class="text-gray-600 text-sm mb-2">{topPick.tagline}</p>
      <p class="text-xs text-green-700 font-semibold mb-3">Pairs with: {panelPairing[topPick.slug]}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener"
           class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Unit</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Best For</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Capacity</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Solar Input</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Weight</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2 text-xs text-green-700 font-medium">{bestFor[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Capacity']}</td>
              <td class="border border-gray-200 px-3 py-2 font-semibold">{p.specs['Solar Input']}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Weight']}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener"
                   class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-2xl p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">
              #{i + 1} — {bestFor[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
            <div class="text-xs text-gray-500 mt-0.5">Max solar: {p.specs['Solar Input']}</div>
          </div>
        </div>

        <div class="bg-green-50 border border-green-100 rounded-lg p-3 mb-4 text-xs text-green-800">
          <strong>Solar pairing:</strong> {panelPairing[p.slug]}
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener"
           class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Solar Tailgating Generator Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">How Much Solar Do You Actually Need?</h3>
      <p class="text-gray-700 text-sm mb-4">
        A typical tailgate setup (32" TV + mini-fridge + Bluetooth speaker + phone charging) draws about 160–220W continuously. To run net-zero on solar, you need solar output that matches or exceeds this load. A 220W panel in direct sun produces roughly 180–200W of actual output. That's essentially break-even — your battery stays at the same level all day instead of draining. Add a second panel or use a higher-input unit like the EcoFlow River 2 Pro (500W solar max) to actually build a reserve.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Setting Up Solar on a Tailgate</h3>
      <p class="text-gray-700 text-sm mb-4">
        Foldable solar panels stand independently with their built-in kickstand. In a parking lot, prop them on the roof of your car, lay them flat on the concrete (bifacial panels benefit from reflected ground light), or lean them against your vehicle facing south. Most panels need to be within 5–10 meters of the power station — the included cable usually reaches.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">LFP vs. NMC for Tailgating</h3>
      <p class="text-gray-700 text-sm">
        All picks except the Jackery Explorer 500 use LFP (lithium iron phosphate) chemistry. LFP batteries handle the deep discharge cycles of all-day events better than NMC — they don't degrade as quickly from full-discharge/full-recharge cycles. If you tailgate frequently, LFP is worth paying for.
      </p>
    </div>

    <!-- Internal Links -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/backup-power/best-generator-for-tailgating/" class="text-blue-600 hover:underline">Best Generator for Tailgating (Including Gas Options)</a></li>
        <li>→ <a href="/backup-power/best-portable-power-station-under-500/" class="text-blue-600 hover:underline">Best Portable Power Stations Under $500</a></li>
        <li>→ <a href="/backup-power/best-solar-generator-home-backup/" class="text-blue-600 hover:underline">Best Solar Generator for Home Backup</a></li>
        <li>→ <a href="/backup-power/solar-generator-vs-portable-generator/" class="text-blue-600 hover:underline">Solar Generator vs Gas Generator — Which to Choose</a></li>
        <li>→ <a href="/backup-power/best-solar-panels-home-backup/" class="text-blue-600 hover:underline">Best Solar Panels for Home Backup</a></li>
      </ul>
    </div>

  </article>
</Layout>
