---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'jackery-explorer-500',
  'anker-solix-c800',
  'ecoflow-river-2-pro',
  'honda-eu2200i',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const bestFor: Record<string, string> = {
  'jackery-explorer-500': 'Best Overall — Lightest, Most Portable',
  'anker-solix-c800': 'Best Value — More Power for the Price',
  'ecoflow-river-2-pro': 'Best for Fast Charging Before Game Day',
  'honda-eu2200i': 'Best for All-Day Events and Power-Heavy Setups',
};

const fuelType: Record<string, string> = {
  'jackery-explorer-500': 'Battery (no fuel)',
  'anker-solix-c800': 'Battery (no fuel)',
  'ecoflow-river-2-pro': 'Battery (no fuel)',
  'honda-eu2200i': 'Gasoline',
};
---

<Layout
  title="Best Generator for Tailgating (2025) — Portable Power for TV, Fridge, and Speakers"
  description="The best generators for tailgating in 2025 — portable battery power stations and quiet inverter generators for running TVs, mini-fridges, speakers, and phone chargers at any tailgate."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/backup-power/" class="hover:underline">Backup Power</a> &rsaquo;
      <span class="text-gray-700">Best Generator for Tailgating</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Generator for Tailgating (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      Tailgating power needs are straightforward: run a TV, keep a mini-fridge cold, power a speaker or two, and charge phones. A 500–800Wh battery power station handles most setups for 3–5 hours without fuel, fumes, or noise restrictions. For all-day events or power-heavy setups, a quiet gas inverter generator fills the gap. Here's what works for each scenario.
    </p>

    <!-- Power Needs Box -->
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-8 text-sm text-amber-900">
      <strong>Typical tailgate power draw:</strong> Portable TV (~80–120W) + mini-fridge (~40–60W) + Bluetooth speaker (~20W) + phone charging (~20W) = roughly 160–220W total. A 500Wh battery runs that setup for 2–3 hours. A 768Wh unit like the Anker C800 or EcoFlow River 2 Pro extends that to 3–4+ hours. Gas generators run indefinitely as long as you have fuel.
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Top Pick — Best Portable Tailgate Power Station</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Unit</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Best For</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Output / Capacity</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Fuel</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Weight</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2 text-xs text-green-700 font-medium">{bestFor[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Capacity'] || p.specs['Output']}</td>
              <td class="border border-gray-200 px-3 py-2 text-xs">{fuelType[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Weight']}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">
              #{i + 1} — {bestFor[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
            <div class="text-xs text-gray-500 mt-0.5">{fuelType[p.slug]}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Tailgate Generator Buying Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Battery vs Gas for Tailgating</h3>
      <p class="text-gray-700 text-sm mb-4">
        Battery power stations are the default choice for parking lot tailgating because there's no fuel to store, no exhaust fumes, and no noise that draws complaints. Most stadium parking lots prohibit gas generators — battery stations are always permitted. Gas generators like the Honda EU2200i make sense for all-day tailgates, hunting camps, or events where you're running high-draw appliances like an electric griddle or air compressor.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">What 500Wh Runs and For How Long</h3>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-xs border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Appliance</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Draw</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Runtime (500Wh)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">32" portable TV</td><td class="border border-gray-200 px-2 py-1.5">~80W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~5 hours</td></tr>
            <tr class="bg-gray-50"><td class="border border-gray-200 px-2 py-1.5">Mini-fridge (12V)</td><td class="border border-gray-200 px-2 py-1.5">~40–60W avg</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~8 hours</td></tr>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">Bluetooth speaker</td><td class="border border-gray-200 px-2 py-1.5">~20–30W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~15 hours</td></tr>
            <tr class="bg-gray-50"><td class="border border-gray-200 px-2 py-1.5">TV + fridge + speaker combined</td><td class="border border-gray-200 px-2 py-1.5">~160W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~2.5–3 hours</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">The Honda Advantage for All-Day Events</h3>
      <p class="text-gray-700 text-sm mb-4">
        The Honda EU2200i at 48 dB quarter-load is the quietest gas generator available — comparable to a normal conversation. It runs 8 hours on less than 1 gallon of gas and outputs clean sine wave power safe for TVs and electronics. For a 10-hour tailgate parking lot event where noise rules are relaxed (tailgating from a campsite, private lot, or farm), the Honda lets you run everything indefinitely without battery anxiety.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/backup-power/best-portable-power-station-under-500/" class="text-blue-600 hover:underline">Best Portable Power Stations Under $500</a></li>
        <li>→ <a href="/backup-power/best-portable-generator-for-camping/" class="text-blue-600 hover:underline">Best Portable Generator for Camping</a></li>
        <li>→ <a href="/backup-power/best-solar-generator-for-camping/" class="text-blue-600 hover:underline">Best Solar Generator for Camping</a></li>
        <li>→ <a href="/backup-power/solar-generator-vs-portable-generator/" class="text-blue-600 hover:underline">Solar Generator vs Gas Generator — Which to Choose</a></li>
      </ul>
    </div>

  </div>
</Layout>
