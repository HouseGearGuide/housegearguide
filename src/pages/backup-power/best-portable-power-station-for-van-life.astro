---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'ecoflow-delta-2',
  'bluetti-ac180',
  'jackery-explorer-1000-pro',
  'anker-solix-c800',
  'ecoflow-delta-2-max',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const vanLifeNote: Record<string, string> = {
  'ecoflow-delta-2': 'Best All-Rounder',
  'bluetti-ac180': 'Best Recharge Speed',
  'jackery-explorer-1000-pro': 'Most Portable 1kWh',
  'anker-solix-c800': 'Best Budget Pick',
  'ecoflow-delta-2-max': 'Best for Full-Time Van Life',
};

const weight: Record<string, string> = {
  'ecoflow-delta-2': '27 lbs',
  'bluetti-ac180': '35 lbs',
  'jackery-explorer-1000-pro': '25.1 lbs',
  'anker-solix-c800': '19.4 lbs',
  'ecoflow-delta-2-max': '48 lbs',
};

const solarInput: Record<string, string> = {
  'ecoflow-delta-2': 'Up to 500W',
  'bluetti-ac180': 'Up to 900W',
  'jackery-explorer-1000-pro': 'Up to 600W',
  'anker-solix-c800': 'Up to 400W',
  'ecoflow-delta-2-max': 'Up to 1000W',
};
---

<Layout
  title="Best Portable Power Station for Van Life (2025) — Top Picks for Full-Time and Weekend Van Builds"
  description="The best portable power stations for van life — ranked by capacity, solar input, weight, and real-world off-grid performance. Covers weekend warriors to full-time van dwellers."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/backup-power/" class="hover:underline">Backup Power</a> &rsaquo;
      <span class="text-gray-700">Best Portable Power Station for Van Life</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Portable Power Station for Van Life (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      Van life power is different from home backup power. You're charging from solar panels on the roof, from your alternator while driving, and occasionally from shore power at a campsite. The right station needs enough capacity to last through a cloudy day, fast solar recharge to top back up by noon on a sunny one, and a weight you can actually lift in and out of the van.
    </p>

    <!-- Van Life Power Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8 text-sm text-blue-900">
      <strong>How much capacity do you actually need?</strong>
      <ul class="mt-2 space-y-1 list-disc list-inside">
        <li><strong>Weekend trips:</strong> 500–800Wh covers a laptop, phone charging, and LED lighting for 2 nights</li>
        <li><strong>Extended trips (1–2 weeks):</strong> 1000–1200Wh — enough for a laptop + fan + small cooler</li>
        <li><strong>Full-time van life:</strong> 2000Wh+ — or 1000Wh with reliable daily solar and driving recharge</li>
      </ul>
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Best Van Life Power Station for Most Builds</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Station</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Best For</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Capacity</th>
            <th class="border border-gray-200 px-3 py-2 text-left">AC Output</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Solar Input</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Weight</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2 text-xs text-green-700 font-medium">{vanLifeNote[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Capacity'] || p.specs['Battery'] || '—'}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['AC Output'] || '—'}</td>
              <td class="border border-gray-200 px-3 py-2">{solarInput[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{weight[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">
              #{i + 1} — {vanLifeNote[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
            <div class="text-xs text-gray-500 mt-0.5">{weight[p.slug]}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Van Life Power: What to Look For</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Solar Input Is the Most Important Spec</h3>
      <p class="text-gray-700 text-sm mb-4">
        In a van, your primary charging source is solar. A station with 500W solar input can accept two 250W panels and fully recharge from near-empty in 3–4 hours of good sun. The EcoFlow Delta 2 accepts up to 500W; the Delta 2 Max takes up to 1000W. Higher solar input tolerance is essential for full-time use where shore power isn't reliable.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">12V Car Charging (Alternator Recharge)</h3>
      <p class="text-gray-700 text-sm mb-4">
        Every station here charges from a 12V car outlet (cigarette lighter) while you drive. Expect 80–120W at 12V — enough to add 40–60Wh per hour of driving. A long driving day of 6 hours adds roughly 300–400Wh, which offsets a typical night's power draw. The EcoFlow models also support 12V/30A DC5521 charging at 200–300W for even faster alternator charging.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">LFP vs. NMC Battery Chemistry</h3>
      <p class="text-gray-700 text-sm mb-4">
        LFP (lithium iron phosphate) batteries last 3,000–3,500 charge cycles before degrading to 80% capacity. NMC (nickel manganese cobalt) typically lasts 500–1,000 cycles. For van life where you're cycling daily, LFP pays for itself in longevity. EcoFlow Delta 2 and Delta 2 Max use LFP. Check the spec sheet for any station before buying for full-time use.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Weight vs. Capacity Tradeoff</h3>
      <p class="text-gray-700 text-sm mb-4">
        The Anker Solix C800 weighs 19 lbs for 768Wh — that's the lightest option here. The Delta 2 Max gives you twice the capacity at 48 lbs. For a van where the station stays mounted, weight matters less. For a station you frequently carry out for camping or move around daily, lighter wins.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/backup-power/best-portable-power-station-under-1000/" class="text-blue-600 hover:underline">Best Portable Power Stations Under $1,000</a></li>
        <li>→ <a href="/backup-power/best-solar-panels-home-backup/" class="text-blue-600 hover:underline">Best Solar Panels for Off-Grid Charging</a></li>
        <li>→ <a href="/backup-power/ecoflow-vs-jackery/" class="text-blue-600 hover:underline">EcoFlow vs. Jackery — Full Brand Comparison</a></li>
      </ul>
    </div>

  </div>
</Layout>
