---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'ecoflow-delta-2-max',
  'ecoflow-delta-pro',
  'bluetti-ep500pro',
  'jackery-explorer-1000-pro',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const bestFor: Record<string, string> = {
  'ecoflow-delta-2-max': 'Best Overall — Expandable + Fast Recharge',
  'ecoflow-delta-pro': 'Best for Whole-Home Partial Backup',
  'bluetti-ep500pro': 'Best Long-Term Outage Unit',
  'jackery-explorer-1000-pro': 'Best Portable Emergency Station',
};
---

<Layout
  title="Best Portable Power Station for Emergencies (2025) — Hurricane, Outage, and Disaster Prep"
  description="The best portable power stations for emergency preparedness in 2025 — high-capacity units that power fridges, medical equipment, CPAP, and lights during extended outages. Top picks from EcoFlow, Bluetti, and Jackery."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/backup-power/" class="hover:underline">Backup Power</a> &rsaquo;
      <span class="text-gray-700">Best Portable Power Station for Emergencies</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Portable Power Station for Emergencies (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      Emergency power stations need to do three things: hold a charge for months of standby, power critical loads (fridge, medical equipment, lights, communication) for 24–72+ hours, and recharge quickly when power returns. The units below are the strongest options for serious emergency preparedness — from a 2,000Wh unit that can run a fridge for two days to a 3,600Wh station with whole-home circuit integration.
    </p>

    <!-- Emergency Prep Box -->
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8 text-sm text-red-900">
      <strong>Emergency prep reality check:</strong> A standard refrigerator draws 100–200W and runs in cycles, averaging ~50–80W over time. A 2,000Wh unit runs a typical fridge for 25–40 hours. A CPAP draws 30–80W — a 1,000Wh unit gives you 2 nights. A sump pump draws 400–800W surge, 200–400W running — size your unit's inverter capacity to at least 1,500W for sump pump use. All units here accept solar input for extended off-grid operation.
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Top Pick — Best Emergency Power Station</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Unit</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Capacity</th>
            <th class="border border-gray-200 px-3 py-2 text-left">AC Output</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Solar Input</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2 font-semibold">{p.specs['Capacity']}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['AC Output']}</td>
              <td class="border border-gray-200 px-3 py-2 text-green-700 font-semibold">{p.specs['Solar Input']}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">
              #{i + 1} — {bestFor[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Emergency Power Station Buying Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">How Long Will It Run Your Critical Devices?</h3>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-xs border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Device</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Draw</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">2,000Wh Runtime</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">3,600Wh Runtime</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">Refrigerator</td><td class="border border-gray-200 px-2 py-1.5">~70W avg</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~28 hours</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~50 hours</td></tr>
            <tr class="bg-gray-50"><td class="border border-gray-200 px-2 py-1.5">CPAP (no humidifier)</td><td class="border border-gray-200 px-2 py-1.5">~40W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~50 hours</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~90 hours</td></tr>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">LED lights (4 bulbs)</td><td class="border border-gray-200 px-2 py-1.5">~40W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~50 hours</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~90 hours</td></tr>
            <tr class="bg-gray-50"><td class="border border-gray-200 px-2 py-1.5">Laptop + phone charging</td><td class="border border-gray-200 px-2 py-1.5">~80W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~25 hours</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~45 hours</td></tr>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">Fridge + lights + CPAP</td><td class="border border-gray-200 px-2 py-1.5">~150W avg</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~13 hours</td><td class="border border-gray-200 px-2 py-1.5 font-medium">~24 hours</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Solar + Battery = Indefinite Emergency Power</h3>
      <p class="text-gray-700 text-sm mb-4">
        The real advantage of a large power station for emergencies isn't just the battery — it's the solar input. The EcoFlow Delta 2 Max accepts up to 1,000W of solar input and can fully recharge in as little as 1.5 hours on a clear day with four 250W panels. This means extended grid outages (hurricanes, ice storms) become manageable as long as you have solar panels deployed. A 2,000Wh unit with 400W of solar input runs critical loads indefinitely as long as there's sun.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">LFP Battery = Safe Indoor Storage</h3>
      <p class="text-gray-700 text-sm mb-4">
        All four units here use LFP (LiFePO4) chemistry, which is thermally stable and does not experience thermal runaway — making them safe to store indoors, in a garage, or in a closet. NMC batteries (found in older units) carry a small but real fire risk if punctured or stored incorrectly. For an emergency unit that sits in a closet for months at a time, LFP is the only chemistry worth buying.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/backup-power/best-portable-power-station-under-1000/" class="text-blue-600 hover:underline">Best Portable Power Stations Under $1,000</a></li>
        <li>→ <a href="/backup-power/best-battery-backup-sump-pump/" class="text-blue-600 hover:underline">Best Battery Backup for Sump Pumps</a></li>
        <li>→ <a href="/backup-power/best-battery-backup-medical-equipment/" class="text-blue-600 hover:underline">Best Battery Backup for Medical Equipment</a></li>
        <li>→ <a href="/backup-power/best-generator-for-power-outages/" class="text-blue-600 hover:underline">Best Generator for Power Outages</a></li>
      </ul>
    </div>

  </div>
</Layout>
