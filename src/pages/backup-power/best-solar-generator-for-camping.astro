---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'ecoflow-river-2-pro',
  'jackery-explorer-500',
  'goal-zero-yeti-500x',
  'bluetti-eb3a',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const bestFor: Record<string, string> = {
  'ecoflow-river-2-pro': 'Best Overall — LFP + fastest solar recharge',
  'jackery-explorer-500': 'Best for Ultralight Camping',
  'goal-zero-yeti-500x': 'Best for Goal Zero Solar Ecosystem',
  'bluetti-eb3a': 'Best Budget — LFP under $200',
};
---

<Layout
  title="Best Solar Generator for Camping (2025) — Lightweight, LFP Battery, Fast Solar Recharge"
  description="The best solar generators for camping in 2025 — compared by weight, solar input, capacity, and LFP vs NMC battery. Top picks from EcoFlow, Jackery, Goal Zero, and Bluetti."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/backup-power/" class="hover:underline">Backup Power</a> &rsaquo;
      <span class="text-gray-700">Best Solar Generator for Camping</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Solar Generator for Camping (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      A solar generator is a portable power station that pairs with solar panels to recharge off-grid — no gas, no noise, no fumes. For camping, the right choice depends on how much power you actually need, how important weight is, and whether you'll be stationary at a site or moving daily. The best camping solar generators are light enough to carry, capable of handling a fridge or CPAP, and able to recharge fully in a day of good sun.
    </p>

    <!-- What to Know Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8 text-sm text-blue-900">
      <strong>Solar recharge reality check:</strong> A 100W solar panel produces roughly 300–500Wh on a sunny day after accounting for panel angle, efficiency, and cloud cover. A 500Wh unit takes 1–2 days to fully recharge from a single 100W panel. Match your panel wattage to your unit's solar input spec — and buy a unit with high solar input if you plan to recharge daily.
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Top Pick — Best Solar Generator for Camping</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Power Station</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Capacity</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Solar Input</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Weight</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Battery</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Capacity']}</td>
              <td class="border border-gray-200 px-3 py-2 font-semibold text-green-700">{p.specs['Solar Input']}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Weight']}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Battery Type']}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">
              #{i + 1} — {bestFor[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Camping Solar Generator Buying Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">How Much Capacity Do You Need?</h3>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-xs border-collapse border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Camping Style</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Typical Devices</th>
              <th class="border border-gray-200 px-2 py-1.5 text-left">Recommended Capacity</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">Minimalist — phones, headlamp, small speaker</td><td class="border border-gray-200 px-2 py-1.5">~50–100W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">200–300Wh (Bluetti EB3A)</td></tr>
            <tr class="bg-gray-50"><td class="border border-gray-200 px-2 py-1.5">Car camping — fridge, fan, CPAP, laptop</td><td class="border border-gray-200 px-2 py-1.5">~150–300W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">500–800Wh (EcoFlow River 2 Pro)</td></tr>
            <tr class="bg-white"><td class="border border-gray-200 px-2 py-1.5">Base camp or van life — larger fridge, multiple devices, lights</td><td class="border border-gray-200 px-2 py-1.5">~300–600W</td><td class="border border-gray-200 px-2 py-1.5 font-medium">1000Wh+ (EcoFlow DELTA 2)</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">LFP vs NMC Battery for Camping</h3>
      <p class="text-gray-700 text-sm mb-4">
        LFP (LiFePO4) batteries last 2,500–4,000 cycles vs 500–800 cycles for NMC. For a camping unit you'll use every weekend, LFP pays for itself in longevity — the EcoFlow River 2 Pro, Goal Zero Yeti 500 6th Gen, and Bluetti EB3A all use LFP. The Jackery Explorer 500 uses NMC, which is fine for occasional campers but adds up over years of frequent use.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Solar Panel Pairing</h3>
      <p class="text-gray-700 text-sm mb-4">
        Match your solar panel wattage to your unit's solar input limit. Pairing a 220W panel with a unit that only accepts 100W wastes money and power. The EcoFlow River 2 Pro accepts up to 500W — pair it with a 110W EcoFlow panel to recharge fully in 4–5 hours of peak sun. The Jackery Explorer 500 caps at 100W — one SolarSaga 100 panel will do.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Weight Matters for Backpacking vs Car Camping</h3>
      <p class="text-gray-700 text-sm mb-4">
        The Bluetti EB3A at 10.1 lbs can go in a car camping bag. The Jackery Explorer 500 at 13.3 lbs stays in the car at a campsite. The EcoFlow River 2 Pro at 17.5 lbs needs to be carried to the site but isn't painful. None of these are true backpacking units — for backpacking, look at smaller solar chargers paired with a 10,000–30,000mAh USB bank instead.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/backup-power/best-portable-power-station-under-500/" class="text-blue-600 hover:underline">Best Portable Power Stations Under $500</a></li>
        <li>→ <a href="/backup-power/best-portable-generator-for-camping/" class="text-blue-600 hover:underline">Best Portable Generator for Camping (Gas)</a></li>
        <li>→ <a href="/backup-power/solar-generator-vs-portable-generator/" class="text-blue-600 hover:underline">Solar Generator vs Gas Generator — Which to Choose</a></li>
        <li>→ <a href="/backup-power/best-solar-generator-home-backup/" class="text-blue-600 hover:underline">Best Solar Generator for Home Backup</a></li>
      </ul>
    </div>

  </div>
</Layout>
