---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'arlo-pro-4-spotlight',
  'ring-smart-floodlight-battery',
  'kasa-outdoor-smart-plug-ep40a',
  'govee-outdoor-flood-lights',
  'philips-hue-lily-outdoor',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const deviceType: Record<string, string> = {
  'arlo-pro-4-spotlight': 'Outdoor Camera',
  'ring-smart-floodlight-battery': 'Security Light',
  'kasa-outdoor-smart-plug-ep40a': 'Outdoor Smart Plug',
  'govee-outdoor-flood-lights': 'Decorative Flood Lights',
  'philips-hue-lily-outdoor': 'Landscape Spotlight',
};

const powerType: Record<string, string> = {
  'arlo-pro-4-spotlight': 'Battery (solar optional)',
  'ring-smart-floodlight-battery': 'Battery',
  'kasa-outdoor-smart-plug-ep40a': 'Plug-in',
  'govee-outdoor-flood-lights': 'Plug-in',
  'philips-hue-lily-outdoor': 'Low-voltage wired',
};
---

<Layout
  title="Best Outdoor Smart Home Devices (2025) — Cameras, Lights, Plugs, and Landscape Lighting"
  description="The best outdoor smart home devices for 2025 — covers wire-free outdoor cameras, smart security lights, outdoor plugs, decorative flood lights, and landscape spotlights. Honest picks for every outdoor use case."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/smart-home/" class="hover:underline">Smart Home</a> &rsaquo;
      <span class="text-gray-700">Best Outdoor Smart Home Devices</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Outdoor Smart Home Devices (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      Outdoor smart home tech covers a lot of ground: security cameras that capture intruders in 2K HDR, motion-activated floodlights, plugs for outdoor holiday lights and patio appliances, decorative color lighting for entertaining, and landscape spotlights for curb appeal. Each category has different installation requirements and weather ratings — this guide covers the best pick in each.
    </p>

    <!-- Weather Rating Box -->
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-8 text-sm text-amber-900">
      <strong>IP rating quick reference:</strong> IP44 = splash resistant (light rain only). IP55 = protected against rain from all directions. IP65 = dust-tight + direct rain resistant. IP66 = dust-tight + heavy rain and pressure wash resistant. IP67 = dust-tight + short-term submersion. For outdoor year-round use, aim for at least IP65.
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Top Pick — Most Versatile Outdoor Smart Device</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Device</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Type</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Power</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Weather Rating</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2">{deviceType[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2 text-xs">{powerType[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Weather Rating'] || p.specs['Waterproof Rating'] || '—'}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">
              #{i + 1} — {deviceType[p.slug]} · {powerType[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Outdoor Smart Device Buying Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Security vs Ambiance — Two Different Goals</h3>
      <p class="text-gray-700 text-sm mb-4">
        Security outdoor devices (cameras, floodlights) are designed to deter and capture — they face driveways, walkways, and entry points. Ambiance devices (Govee flood lights, Philips Hue Lily) are designed to make your outdoor space look great for entertaining. The best outdoor setups have both: a camera covering the entry point and decorative lighting on the patio or landscape.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Battery vs Wired Outdoor Devices</h3>
      <p class="text-gray-700 text-sm mb-4">
        Battery-powered devices (Arlo camera, Ring floodlight) install anywhere without an electrician. The trade-off is periodic recharging. Wired devices (Philips Hue Lily, Govee flood lights) have no battery maintenance but require an outdoor outlet or low-voltage transformer. If you're adding devices to an existing structure, battery-powered is almost always easier.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">The Outdoor Plug Nobody Thinks About</h3>
      <p class="text-gray-700 text-sm mb-4">
        The Kasa EP40 outdoor smart plug is underrated. At $17, it lets you automate holiday lights, outdoor fans, patio string lights, and landscape lighting on a schedule — no hub, no subscription. Set it to turn on at sunset and off at midnight via the Kasa app. It's the fastest return on investment of any outdoor device on this list.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/smart-home/best-outdoor-security-camera-system/" class="text-blue-600 hover:underline">Best Outdoor Security Camera Systems</a></li>
        <li>→ <a href="/smart-home/best-outdoor-smart-plugs/" class="text-blue-600 hover:underline">Best Outdoor Smart Plugs</a></li>
        <li>→ <a href="/smart-home/best-battery-powered-outdoor-lights/" class="text-blue-600 hover:underline">Best Battery-Powered Outdoor Smart Lights</a></li>
        <li>→ <a href="/smart-home/best-smart-doorbell-camera/" class="text-blue-600 hover:underline">Best Smart Doorbell Cameras</a></li>
      </ul>
    </div>

  </div>
</Layout>
