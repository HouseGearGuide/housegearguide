---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import type { Product } from '../../data/products';

const slugOrder = ['wyze-cam-v4', 'eufy-indoor-cam-2k-pan-tilt', 'arlo-essential-indoor-2k'];
const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!).filter(Boolean) as Product[];
const topPick = picks[0];
---

<Layout
  title="Best Smart Security Camera for Apartments Under $100 (2026)"
  description="The best apartment security cameras under $100 in 2026. Wyze Cam v4 ($36), Eufy 2K Pan & Tilt ($40), and Arlo Essential Indoor ($100) — no drilling, no subscription required."
>
  <div class="bg-amber-50 border-b border-amber-100">
    <div class="max-w-4xl mx-auto px-4 py-2 text-xs text-amber-800 text-center">
      This site earns commissions from purchases made through our links at no extra cost to you.
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 py-12">

    <nav class="text-xs text-gray-400 mb-6">
      <a href="/" class="hover:text-green-700">Home</a>
      <span class="mx-2">›</span>
      <a href="/smart-home/" class="hover:text-green-700">Smart Home</a>
      <span class="mx-2">›</span>
      Best Security Cameras for Apartments Under $100
    </nav>

    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3 leading-tight">
      Best Smart Security Camera for Apartments Under $100 (2026)
    </h1>
    <p class="text-sm text-gray-400 mb-8">Last updated: June 2026 · 3 cameras compared by price, storage, and features</p>

    <p class="text-lg text-gray-700 mb-4 leading-relaxed">
      The best apartment security camera isn't necessarily the most expensive one — it's the one that covers your door, stores footage without a monthly fee, and sits on a shelf without a single screw in the wall. All three picks here are under $100, sit on any flat surface, plug into a standard outlet, and include free local storage on a microSD card.
    </p>
    <p class="text-lg text-gray-700 mb-8 leading-relaxed">
      The Wyze Cam v4 at $36 does 90% of what the $100 Arlo does. The Eufy Pan & Tilt at $40 covers an entire room with one camera. The Arlo at $100 is the ceiling — it's here because it adds HomeKit support and the best multi-platform compatibility of anything under $100. If you're in the Apple ecosystem, it's worth the premium.
    </p>

    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-5 mb-10">
      <p class="font-semibold text-gray-900 mb-2 text-sm">What separates a good apartment camera from a mediocre one</p>
      <ul class="space-y-1.5 text-sm text-gray-700">
        <li class="flex gap-2"><span class="text-blue-500 font-bold flex-shrink-0">✓</span>Free local storage (microSD) — no subscription needed to view yesterday's footage</li>
        <li class="flex gap-2"><span class="text-blue-500 font-bold flex-shrink-0">✓</span>Surface-mount base — sits on a shelf, bookcase, or TV stand without drilling</li>
        <li class="flex gap-2"><span class="text-blue-500 font-bold flex-shrink-0">✓</span>Two-way audio — speak through the camera to delivery people at your door</li>
        <li class="flex gap-2"><span class="text-blue-500 font-bold flex-shrink-0">✓</span>Motion zones — only alert when motion happens in the area you care about</li>
      </ul>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-10">
      <p class="text-xs font-semibold text-green-700 uppercase tracking-widest mb-3">Best Value — Top Pick Under $100</p>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</h2>
          <p class="text-gray-600 text-sm mb-2">{topPick.tagline}</p>
          <p class="text-2xl font-bold text-green-700">${topPick.price}</p>
        </div>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener"
          class="inline-block bg-green-700 text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-green-800 transition-colors whitespace-nowrap text-center">
          Check Price on Amazon →
        </a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-4 rounded-xl border border-gray-100">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left p-3 font-semibold text-gray-700">Camera</th>
            <th class="text-left p-3 font-semibold text-gray-700">Price</th>
            <th class="text-left p-3 font-semibold text-gray-700">Resolution</th>
            <th class="text-left p-3 font-semibold text-gray-700">Free Storage</th>
            <th class="text-left p-3 font-semibold text-gray-700">Platforms</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={`border-b border-gray-100 ${i === 0 ? 'bg-green-50' : 'hover:bg-gray-50'}`}>
              <td class="p-3">
                <a href={`#${p.slug}`} class="font-medium text-gray-900 hover:text-green-700">{p.name}</a>
                {i === 0 && <span class="ml-2 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">Top Pick</span>}
              </td>
              <td class="p-3 font-medium text-green-700">${p.price}</td>
              <td class="p-3">{p.specs['Resolution']}</td>
              <td class="p-3">{i === 0 ? 'microSD (included slot)' : i === 1 ? 'microSD (no subscription)' : 'Via SmartHub only'}</td>
              <td class="p-3">{i === 0 ? 'Alexa, Google Home' : i === 1 ? 'Alexa, Google Home' : 'Alexa, Google, HomeKit'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 2-year cost table -->
    <div class="bg-gray-50 rounded-xl p-5 mb-12">
      <p class="font-semibold text-gray-900 mb-3 text-sm">2-Year Total Cost (with and without subscription)</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left pb-2 font-medium text-gray-600">Camera</th>
              <th class="text-left pb-2 font-medium text-gray-600">Upfront</th>
              <th class="text-left pb-2 font-medium text-gray-600">No subscription</th>
              <th class="text-left pb-2 font-medium text-gray-600">With subscription</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-b border-gray-100"><td class="py-2">Wyze Cam v4</td><td>$36</td><td class="text-green-700 font-medium">$36 total</td><td>$84 (+$2/mo Cam Plus)</td></tr>
            <tr class="border-b border-gray-100"><td class="py-2">Eufy Pan & Tilt</td><td>$40</td><td class="text-green-700 font-medium">$40 total</td><td>$40 (no subscription needed)</td></tr>
            <tr><td class="py-2">Arlo Essential Indoor</td><td>$100</td><td>$100 (limited cloud)</td><td>$292 (+$8/mo Arlo Secure)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Eufy's local storage is genuinely free with no limits — the clear winner if you want local storage with zero ongoing cost.</p>
    </div>

    {picks.map((product, i) => (
      <section id={product.slug} class="mb-16 scroll-mt-20">
        <div class="border-t border-gray-100 pt-10 mb-6">
          <p class="text-xs font-semibold text-green-700 uppercase tracking-widest mb-2">
            {i === 0 ? '🏆 Best Value — Most Affordable' : i === 1 ? '🔄 Best Coverage — Pan & Tilt' : '🍎 Best for Apple HomeKit'}
          </p>
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-1">{product.name}</h2>
              <p class="text-gray-500 text-sm">${product.price} &nbsp;·&nbsp; ⭐ {product.rating}/5</p>
            </div>
            <a href={product.affiliateUrl} target="_blank" rel="nofollow noopener"
              class="inline-block bg-green-700 text-white px-5 py-2.5 rounded-lg font-semibold text-sm hover:bg-green-800 transition-colors whitespace-nowrap">
              Check on Amazon →
            </a>
          </div>
        </div>
        <p class="text-gray-700 mb-6 leading-relaxed">{product.tagline}</p>
        <div class="bg-gray-50 rounded-xl p-4 mb-6">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Key Specs</p>
          <div class="grid sm:grid-cols-2 gap-x-8">
            {Object.entries(product.specs).map(([key, val]) => (
              <div class="flex justify-between py-1.5 border-b border-gray-100 last:border-0">
                <span class="text-gray-500 text-sm">{key}</span>
                <span class="font-medium text-gray-900 text-sm">{val}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 mb-6">
          <div class="bg-green-50 rounded-xl p-4">
            <p class="font-semibold text-gray-900 mb-3 text-sm">Pros</p>
            <ul class="space-y-2">
              {product.pros.map(pro => <li class="text-sm text-gray-700 flex gap-2"><span class="text-green-600 flex-shrink-0 mt-0.5">✓</span>{pro}</li>)}
            </ul>
          </div>
          <div class="bg-red-50 rounded-xl p-4">
            <p class="font-semibold text-gray-900 mb-3 text-sm">Cons</p>
            <ul class="space-y-2">
              {product.cons.map(con => <li class="text-sm text-gray-700 flex gap-2"><span class="text-red-500 flex-shrink-0 mt-0.5">✗</span>{con}</li>)}
            </ul>
          </div>
        </div>
        <a href={product.affiliateUrl} target="_blank" rel="nofollow noopener"
          class="inline-block border border-green-700 text-green-700 px-5 py-2.5 rounded-lg font-semibold text-sm hover:bg-green-700 hover:text-white transition-colors">
          Buy {product.name} on Amazon →
        </a>
      </section>
    ))}

    <section class="border-t border-gray-100 pt-10 mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Buyer's Guide: Apartment Camera Under $100</h2>
      <div class="space-y-6 text-gray-700">
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Where should you put the camera?</h3>
          <p class="text-sm leading-relaxed">In a one-bedroom or studio, one camera on a high shelf or bookcase pointed at the front door covers most of what you need. In a two-bedroom, add a second camera in the living room covering the balcony or secondary window. Never mount cameras in bedrooms or bathrooms — both for privacy and for legal reasons in most states. The Eufy Pan & Tilt, which can sweep a whole room, is especially useful in studio apartments where one camera needs to do everything.</p>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Do you need to tell your landlord?</h3>
          <p class="text-sm leading-relaxed">Indoor cameras inside your own unit generally don't require landlord permission — you have a reasonable expectation of privacy in your apartment. The key rule: cameras can only point inside your own space, not at shared hallways, neighbor doors, or common areas. Check your lease, as some explicitly address cameras. If you're adding an outdoor camera to a balcony or patio, landlord permission is more commonly required and worth confirming first.</p>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 mb-2">MicroSD vs. cloud storage — what's the real difference?</h3>
          <p class="text-sm leading-relaxed">Cloud storage means footage is uploaded to the company's servers — accessible from anywhere, but dependent on your internet connection and a monthly fee for history beyond a day. Local microSD storage saves footage directly to a card in the camera — free, private, and accessible even without internet (via direct app connection). For apartments where you primarily want to check who came to the door or what happened while you were gone, local storage is completely sufficient. A 64GB card ($10–$12) holds 2–3 weeks of motion events at 2K.</p>
        </div>
      </div>
    </section>

    <section class="border-t border-gray-100 pt-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Related Guides</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/smart-home/best-smart-camera-for-apartments/" class="group block border border-gray-100 rounded-xl p-4 hover:border-green-200 hover:shadow-sm transition-all">
          <p class="text-xs text-green-700 font-semibold uppercase tracking-widest mb-1">Smart Home</p>
          <p class="font-medium text-gray-900 text-sm group-hover:text-green-700 transition-colors">Best Smart Cameras for Apartments →</p>
        </a>
        <a href="/smart-home/best-smart-home-security-system-for-apartment-dwellers/" class="group block border border-gray-100 rounded-xl p-4 hover:border-green-200 hover:shadow-sm transition-all">
          <p class="text-xs text-green-700 font-semibold uppercase tracking-widest mb-1">Smart Home</p>
          <p class="font-medium text-gray-900 text-sm group-hover:text-green-700 transition-colors">Best Security Systems for Apartment Dwellers →</p>
        </a>
        <a href="/smart-home/best-smart-home-devices-for-renters/" class="group block border border-gray-100 rounded-xl p-4 hover:border-green-200 hover:shadow-sm transition-all">
          <p class="text-xs text-green-700 font-semibold uppercase tracking-widest mb-1">Smart Home</p>
          <p class="font-medium text-gray-900 text-sm group-hover:text-green-700 transition-colors">Best Smart Home Devices for Renters →</p>
        </a>
        <a href="/smart-home/best-video-doorbell-for-apartments-with-no-doorbell/" class="group block border border-gray-100 rounded-xl p-4 hover:border-green-200 hover:shadow-sm transition-all">
          <p class="text-xs text-green-700 font-semibold uppercase tracking-widest mb-1">Smart Home</p>
          <p class="font-medium text-gray-900 text-sm group-hover:text-green-700 transition-colors">Best Video Doorbell for Apartments (No Wiring) →</p>
        </a>
      </div>
    </section>

  </article>
</Layout>
