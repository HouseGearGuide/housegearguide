---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

const slugOrder = [
  'lutron-caseta-dimmer',
  'leviton-d26hd-dimmer',
  'kasa-smart-dimmer-hs220',
  'ge-cync-smart-switch',
];

const picks = slugOrder.map(slug => products.find(p => p.slug === slug)!);
const topPick = picks[0];

const neutralWire: Record<string, string> = {
  'lutron-caseta-dimmer': 'Not required ✓',
  'leviton-d26hd-dimmer': 'Required',
  'kasa-smart-dimmer-hs220': 'Required',
  'ge-cync-smart-switch': 'Not required ✓',
};

const hubRequired: Record<string, string> = {
  'lutron-caseta-dimmer': 'Yes (Lutron Bridge)',
  'leviton-d26hd-dimmer': 'No',
  'kasa-smart-dimmer-hs220': 'No',
  'ge-cync-smart-switch': 'No',
};

const switchType: Record<string, string> = {
  'lutron-caseta-dimmer': 'Dimmer',
  'leviton-d26hd-dimmer': 'Dimmer',
  'kasa-smart-dimmer-hs220': 'Dimmer',
  'ge-cync-smart-switch': 'On/Off only',
};
---

<Layout
  title="Best Smart Light Switches (2025) — Dimmer, No Neutral Wire, WiFi & Hub Options Compared"
  description="The best smart light switches for every home — no neutral wire options, WiFi dimmers, Matter support, and HomeKit compatibility. Honest comparisons of Lutron, Leviton, Kasa, and GE Cync."
>
  <div class="max-w-4xl mx-auto px-4 py-8">

    <!-- FTC Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-6 text-sm text-yellow-800">
      <strong>Disclosure:</strong> HouseGearGuide earns a commission if you buy through our links — at no cost to you. We only recommend products we've researched thoroughly.
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:underline">Home</a> &rsaquo;
      <a href="/smart-home/" class="hover:underline">Smart Home</a> &rsaquo;
      <span class="text-gray-700">Best Smart Light Switches</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Best Smart Light Switches (2025)</h1>

    <p class="text-lg text-gray-700 mb-6">
      Smart light switches replace your existing wall switch and give you voice control, scheduling, and app control for any light fixture — including ones that can't use smart bulbs (ceiling fans, recessed lighting, outdoor fixtures). The most important question before buying isn't which brand to pick — it's whether your switch box has a neutral wire.
    </p>

    <!-- Neutral Wire Explainer Box -->
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-8 text-sm text-amber-900">
      <strong>Check this before you buy anything:</strong> Open your switch box and look for a bundle of white wires twisted together (usually capped with a wire nut). If you see one — great, any switch on this list works. If there's no white wire in the bundle going to your switch, you have a 2-wire setup and need a <strong>no-neutral switch</strong>. Only the Lutron Caseta and GE Cync work in that case.
    </div>

    <!-- Top Pick Box -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-8">
      <div class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-1">Top Pick — Best for Most Homes</div>
      <div class="text-xl font-bold text-gray-900 mb-1">{topPick.name}</div>
      <p class="text-gray-700 text-sm mb-3">{topPick.tagline}</p>
      <div class="flex items-center gap-4">
        <span class="text-2xl font-bold text-green-700">${topPick.price}</span>
        <a href={topPick.affiliateUrl} target="_blank" rel="nofollow noopener" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          View on Amazon →
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse border border-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="border border-gray-200 px-3 py-2 text-left">Switch</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Type</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Neutral Wire</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Hub</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Platforms</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Price</th>
            <th class="border border-gray-200 px-3 py-2 text-left">Link</th>
          </tr>
        </thead>
        <tbody>
          {picks.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="border border-gray-200 px-3 py-2 font-medium">{p.name}</td>
              <td class="border border-gray-200 px-3 py-2">{switchType[p.slug]}</td>
              <td class={`border border-gray-200 px-3 py-2 ${neutralWire[p.slug].includes('✓') ? 'text-green-700 font-semibold' : ''}`}>{neutralWire[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{hubRequired[p.slug]}</td>
              <td class="border border-gray-200 px-3 py-2">{p.specs['Smart Platforms']}</td>
              <td class="border border-gray-200 px-3 py-2">${p.price}</td>
              <td class="border border-gray-200 px-3 py-2">
                <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="text-blue-600 hover:underline font-medium">Amazon →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Individual Product Reviews -->
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Full Reviews</h2>

    {picks.map((p, i) => (
      <div class="border border-gray-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">
              #{i + 1} — {switchType[p.slug]} · Neutral: {neutralWire[p.slug]}
            </div>
            <h3 class="text-xl font-bold text-gray-900">{p.name}</h3>
            <p class="text-gray-600 text-sm mt-1">{p.tagline}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="text-2xl font-bold text-green-700">${p.price}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
          {Object.entries(p.specs).map(([key, val]) => (
            <div class="bg-gray-50 rounded px-3 py-1.5">
              <span class="font-medium text-gray-700">{key}:</span> {val}
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <div class="font-semibold text-green-700 mb-1 text-sm">Pros</div>
            <ul class="text-sm space-y-1">
              {p.pros.map(pro => <li class="flex gap-1.5"><span class="text-green-500 mt-0.5">✓</span><span>{pro}</span></li>)}
            </ul>
          </div>
          <div>
            <div class="font-semibold text-red-600 mb-1 text-sm">Cons</div>
            <ul class="text-sm space-y-1">
              {p.cons.map(con => <li class="flex gap-1.5"><span class="text-red-400 mt-0.5">✗</span><span>{con}</span></li>)}
            </ul>
          </div>
        </div>

        <a href={p.affiliateUrl} target="_blank" rel="nofollow noopener" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2 rounded-md text-sm transition-colors">
          Check Price on Amazon →
        </a>
      </div>
    ))}

    <!-- Buying Guide -->
    <div class="bg-gray-50 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Smart Switch Buying Guide</h2>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Smart Switch vs. Smart Bulb — Which Is Right?</h3>
      <p class="text-gray-700 text-sm mb-4">
        Smart bulbs work great in table lamps and fixtures you control from the bulb socket. Smart switches are better for recessed lighting, ceiling fans, bathroom vanity bars, and any fixture where you also want the wall switch to work normally. If someone turns off the wall switch on a smart bulb, it loses power and goes offline. A smart switch keeps the fixture always powered and controls it properly.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Hub vs. No Hub</h3>
      <p class="text-gray-700 text-sm mb-4">
        Hub-based switches (Lutron Caseta) use a dedicated RF protocol that's more reliable than WiFi. Direct WiFi switches (Leviton, Kasa, GE) are simpler to set up but can occasionally drop connection on crowded 2.4GHz networks. For most homes, direct WiFi is fine. For a large installation of 10+ switches, Lutron's RF reliability is worth the hub cost.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">3-Way Switch Support</h3>
      <p class="text-gray-700 text-sm mb-4">
        A 3-way setup controls one fixture from two locations — like a hallway with a switch at each end. Both Lutron Caseta and Leviton D26HD support 3-way wiring. Kasa HS220 and GE Cync do not. If you're replacing a 3-way switch, Lutron or Leviton are your only options here.
      </p>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">Apple HomeKit?</h3>
      <p class="text-gray-700 text-sm mb-4">
        Only Lutron Caseta and Leviton D26HD (2nd Gen, Matter) support Apple HomeKit. If your household runs on Apple Home, those are the only two options worth considering. Kasa and GE Cync do not support HomeKit at any price point.
      </p>
    </div>

    <!-- Related Guides -->
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Related Guides</h2>
      <ul class="space-y-2 text-sm">
        <li>→ <a href="/smart-home/google-home-vs-alexa/" class="text-blue-600 hover:underline">Google Home vs. Alexa — Which Ecosystem to Choose</a></li>
        <li>→ <a href="/smart-home/best-smart-home-hub/" class="text-blue-600 hover:underline">Best Smart Home Hubs</a></li>
        <li>→ <a href="/smart-home/best-smart-home-starter-kit-under-500/" class="text-blue-600 hover:underline">Best Smart Home Starter Kits Under $500</a></li>
      </ul>
    </div>

  </div>
</Layout>
